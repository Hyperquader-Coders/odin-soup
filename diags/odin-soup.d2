# odin-soup: its place in the binding graph
# Render:  d2 diags/odin-soup.d2 diags/odin-soup.svg

direction: down

title: "odin-soup" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-soup\nlibsoup 3 3.4.4" {
  style.fill: "#eef6ff"
}
lib: "libsoup-3.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"soup:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection soup
this -> lib: foreign import
